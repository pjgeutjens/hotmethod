---
layout: layouts/base.njk
permalink: index.html
---
<header class="site-header" id="top">
  <a class="brand" href="#top" aria-label="The Hot Method, home">
    {% include "brand-mark.njk" %}
    <small>Strong Hot Pilates</small>
  </a>
  <nav class="primary-nav" aria-label="Primary navigation">
    <a href="#batches">Batches</a>
    <a href="{{ site.eboonadUrl }}">eboonad.com ↗</a>
  </nav>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobileNav">Menu</button>
  <nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation" hidden>
    <a href="#batches">Batches</a>
    <a href="{{ site.eboonadUrl }}">eboonad.com ↗</a>
  </nav>
</header>

<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> {{ copy.hero.eyebrow }}</p>
      <h1 id="hero-title">{% for line in copy.hero.titleLines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</h1>
      <div class="hero-actions">
        <a class="button button-primary" href="#batches">Explore the batches</a>
        <a class="text-link" href="{{ site.eboonadUrl }}">Visit eboonad.com ↗</a>
      </div>
    </div>
    <figure class="hero-visual">
      <img src="{{ '/public/media/batch-1-hero.webp' | url }}" alt="The Hot Method Strong Hot Pilates workshop at Union Yoga" width="658" height="1020">
      <figcaption><span>{{ batches[0].name }}</span> {{ copy.hero.imageCaption }}</figcaption>
    </figure>
    <div class="hero-count" aria-label="{{ batches.length }} published batch">
      <strong>{{ batches.length }}</strong>
      <span>published<br>{% if batches.length == 1 %}batch{% else %}batches{% endif %}</span>
    </div>
  </section>

  <section class="graduates section" id="batches" aria-labelledby="batches-title">
    {% for batch in batches %}
    <div class="section-heading">
      <div>
        <p class="eyebrow"><span></span> {{ batch.name }}</p>
        <h2 id="batches-title">{{ batch.label }} {{ copy.batches.titleSuffix }}</h2>
      </div>
      <dl class="batch-meta">
        <div><dt>Workshop</dt><dd>{{ batch.dateLabel }}</dd></div>
        <div><dt>Location</dt><dd>{{ batch.venue }} · {{ batch.location }}</dd></div>
        <div><dt>Graduates</dt><dd>{{ batch.graduateCount }}</dd></div>
      </dl>
    </div>
    <div class="graduate-grid">
      {% for graduate in graduates | sortByDisplayName %}
      {% if graduate.batchId == batch.id %}
      <article class="graduate-card">
        <div class="graduate-portrait heat-{{ loop.index0 % 4 }}{% if not graduate.image %} is-pending{% endif %}">
          {% if graduate.image %}
          <img src="{{ graduate.image | url }}" alt="Portrait of {{ graduate.displayName }}" loading="lazy" width="500" height="500">
          {% else %}
          <span aria-hidden="true">{{ graduate.initials }}</span>
          <small>Portrait pending</small>
          {% endif %}
        </div>
        <div class="graduate-name">
          <h3>{{ graduate.displayName }}</h3>
          {% if graduate.fullName != graduate.displayName %}<p>{{ graduate.fullName }}</p>{% endif %}
        </div>
      </article>
      {% endif %}
      {% endfor %}
    </div>
    {% endfor %}
  </section>

  <section class="handoff section" aria-labelledby="handoff-title">
    <p class="eyebrow"><span></span> {{ copy.handoff.eyebrow }}</p>
    <div class="handoff-copy">
      <h2 id="handoff-title">{{ copy.handoff.title }}</h2>
      <div>
        <p>{{ copy.handoff.body }}</p>
        <a class="button button-primary" href="{{ site.workshopUrl }}">Continue to eboonad.com ↗</a>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <a class="brand footer-brand" href="#top">
    {% include "brand-mark.njk" %}
    <small>Strong Hot Pilates</small>
  </a>
  <p>Graduate roster · The Hot Method</p>
  <div><a href="{{ site.instagramUrl }}">Instagram ↗</a><a href="{{ site.eboonadUrl }}">eboonad.com ↗</a></div>
</footer>
